# Public Supabase browser settings. The anon key is safe for client use because RLS protects user rows.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=

# Server-only credentials. Never prefix these secrets with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
APP_ORIGIN=http://127.0.0.1:5173
APP_ORIGINS=
SUPABASE_URL=
SUPABASE_ANON_KEY=
API_PORT=3001
# DB_PATH can override data/nxtgen.sqlite
